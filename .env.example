# Copy this file to .env for local development.
POSTGRES_USER=recover
POSTGRES_PASSWORD=recover
POSTGRES_DB=recover_db

# These hostnames are the Compose service names. For a non-Docker backend,
# change postgres and redis to localhost.
DATABASE_URL=postgresql://recover:recover@postgres:5432/recover_db
REDIS_URL=redis://redis:6379/0

# Twilio Voice and WhatsApp Sandbox
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
TWILIO_WHATSAPP_STATUS_URL=https://your-tunnel.trycloudflare.com/twilio/whatsapp/status
TWILIO_VALIDATE_SIGNATURE=false

# Razorpay credentials
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# ---------- Groq (LLM intent classification) ----------
GROQ_API_KEY=replace-with-groq-api-key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret

# Meta WhatsApp Cloud API (if using Meta directly instead of Twilio)
WHATSAPP_TOKEN=replace-with-meta-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-with-your-verify-token

