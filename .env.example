# Cleaned .env.example for Twilio‑only setup
# Copy this file to .env for local development.
POSTGRES_USER=recover
POSTGRES_PASSWORD=recover
POSTGRES_DB=recover_db

# Docker service hostnames (or localhost for non‑Docker)
DATABASE_URL=postgresql://recover:recover@postgres:5432/recover_db
REDIS_URL=redis://redis:6379/0

# Twilio WhatsApp and Voice configuration (real credentials needed)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PUBLIC_BASE_URL=https://your-tunnel.example.com
TWILIO_WHATSAPP_STATUS_URL=https://your-tunnel.example.com/twilio/whatsapp/status
TWILIO_VALIDATE_SIGNATURE=false

# Razorpay credentials (if needed)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Groq LLM API key (optional)
GROQ_API_KEY=replace-with-groq-api-key

# Whitelist/blacklist for WhatsApp numbers (optional)
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_BLOCKED_NUMBERS=
WHATSAPP_AUTOREPLY_ENABLED=false

# Disable mock mode for real Twilio usage
MOCK_MODE=false