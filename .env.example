# Copy this file to .env for local development.
POSTGRES_USER=recover
POSTGRES_PASSWORD=recover
POSTGRES_DB=recover_db

# These hostnames are the Compose service names. For a non-Docker backend,
# change postgres and redis to localhost.
DATABASE_URL=postgresql://recover:recover@postgres:5432/recover_db
REDIS_URL=redis://redis:6379/0

# Required at startup by the WhatsApp client. Replace for real API calls.
WHATSAPP_TOKEN=replace-with-meta-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id

# Optional webhook verification secret.
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

